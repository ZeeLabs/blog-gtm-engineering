# GTM Engineering Blog - Docker ignore file
# Don't copy these files to Docker image

# Documentation and guides
*.md

# Development tools
*.py

# Git
.git
.gitignore

# IDE/Editor files
.vscode
.idea
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
logs/

# Runtime and temporary files
tmp/
temp/
.tmp/

# Node modules (if any)
node_modules/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Test files and reports
*.test.html
test-*
coverage/

# Templates
.templates/
